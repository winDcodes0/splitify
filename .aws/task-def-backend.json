{
  "family": "splitly-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "YOUR_ACCOUNT_ID.dkr.ecr.ap-southeast-2.amazonaws.com/splitly/backend:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3440,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "3440" },
        { "name": "MONGO_URI", "value": "mongodb+srv://tapishbhan29_db_user:FMEbib5zm5Q8M8gy@cluster0.buaalfc.mongodb.net/splitly?retryWrites=true&w=majority&appName=Cluster0" },
        { "name": "JWT_SECRET", "value": "892zpwoierfj4n509183" },
        { "name": "JWT_EXPIRES_IN", "value": "7d" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/splitly-backend",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "curl -f http://localhost:3440/ || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}

